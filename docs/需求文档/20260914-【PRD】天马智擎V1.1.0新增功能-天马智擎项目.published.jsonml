Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "从已完成会话消息读取会话 ID、消息状态、问题、回答、模式、智能体和完成时间；一问一答均成功时记为一个有效轮次。"]]], ["p", {"uuid": "u001771", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001769", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "以用户 ID 关联人员主数据，取得部门和账号状态快照；名称只用于展示，不作为关联或汇总条件。"]]], ["p", {"uuid": "u001772", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001769", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "每小时增量抽取新增或发生变化的记录，按统计日期、部门、模式和智能体生成运营指标数据集，同时生成受限会话明细数据集；因此正常情况下观远最多滞后一个小时批次。"]]], ["p", {"uuid": "u001773", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001769", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "活跃用户、高活跃用户、有效轮次和平均轮次均从有效对话轮次计算；账号分母读取当日已开通且启用账号快照。"]]], ["p", {"uuid": "u001774", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001769", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "批次成功后整体发布并更新“最近成功时间”；批次失败保留上一成功版本，修复后支持按原时间区间补跑，避免重复或漏算。"]]], ["p", {"uuid": "u001775", "spacing": {"line": 1.0, "lineRule": 