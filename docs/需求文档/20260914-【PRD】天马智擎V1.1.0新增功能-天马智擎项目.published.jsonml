ule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "次日重算失败时保留实时初算值，状态改为“待校准”，记录失败原因并支持补跑；补跑成功后覆盖为已校准结果"]]]]], ["tr", {"h": 22, "hRule": "none", "uuid": "u001482"}, ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001479"}, ["p", {"uuid": "u001478", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "额度周期"]]]], ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001481"}, ["p", {"uuid": "u001480", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "人员额度支持按日、周、月设置；额度对象必须是稳定用户 ID，部门行不得直接设置额度"]]]]], ["tr", {"h": 22, "hRule": "none", "uuid": "u001487"}, ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001484"}, ["p", {"uuid": "u001483", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "预警阈值"]]]], ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001486"}, ["p", {"uuid": "u001485", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "本周期剩余额度低于 10% 时在右下角提醒；同一阈值跨越事件只提醒一次"]]]]], ["tr", {"h": 22, "hRule": "none", "uuid": "u001492"}, ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001489"}, ["p", {"uuid": "u001488", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "额度修改"]]]], ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001491"}, ["p", {"uuid": "u001490", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "修改必须填写原因，并记录修改人、时间、前值、后值和原因；当前月修改立即生效但不改变历史流水"]]]]], ["tr", {"h": 22, "hRule": "none", "uuid": "u001497"}, ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001494"}, ["p", {"uuid": "u001493", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "额度不足"]]]], ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001496"}, ["p", {"uuid": "u001495", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "新额度低于本月已用额度时，剩余显示为 0，并沿用现有额度不足逻辑阻止新任务"]]]]], ["tr", {"h": 22, "hRule": "none", "uuid": "u001502"}, ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001499"}, ["p", {"uuid": "u001498", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "默认额度"]]]], ["tc", {"colSpan": 1, "rowSpan": 1, "vAlign": "bottom", "uuid": "u001501"}, ["p", {"uuid": "u001500", "jc": "left", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 11, "szUnit": "pt"}, "未单独设置的月份沿用现有默认额度规则"]]]]]], ["h4", {"uuid": "u001504", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "接口说明"]]], ["p", {"uuid": "u001505", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "产品阶段仅约束查询维度、权限、实际结算口径和额度修改结果；具体接口路径与协议由技术设计定义。"]]], ["h4", {"uuid": "u001506", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "AI 链路说明"]]], ["p", {"uuid": "u001507", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "本模块不涉及新增 AI 推理链路。"]]], ["h3", {"uuid": "u001508", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 2, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 2}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 14.5, "szUnit": "pt"}, "M4-观远运营看板"]]], ["h4", {"uuid": "u001509", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "功能需求描述"]]], ["p", {"uuid": "u001510", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "天马在现有“仪表盘”左侧增加“观远运营看板”菜单，并在内容区内嵌 AI 运营看板。菜单和页面访问均受权限控制，默认仅超级管理员可见；超级管理员可通过“权限设置”配置菜单可见角色或人员。观远 BI 看板上线前展示建设中占位，上线后通过安全嵌入展示。"]]], ["h4", {"uuid": "u001511", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "用户角色与用户故事"]]], ["p", {"uuid": "u001512", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "作为超级管理员，我希望按部门、模式和智能体判断产品是否被使用，并在必要时下钻到原始会话。天马只提供数据和安全入口，不重复开发 BI 图表。"]]], ["h4", {"uuid": "u001513", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "业务主流程图及说明"]]], ["code", {"syntax": "mermaid", "theme": "default", "uuid": "u001514", "code": "flowchart TD\n    A[用户消息与AI回答完成] --> B{是否构成有效对话轮次}\n    B -->|否| C[记录失败原因但不计入有效轮次]\n    B -->|是| D[保存用户/部门/模式/智能体等统计维度]\n    D --> R[请求完成后生成实时初算]\n    R --> E[进入每小时增量批次]\n    T[次日重算前一日 Token] --> E\n    E --> F{数据集更新是否成功}\n    F -->|否| G[保留上次成功数据并自动重试]\n    F -->|是| H[记录最近成功时间]\n    G --> H\n    H --> I{观远看板是否已上线}\n    I -->|否| J[仪表盘展示建设中占位]\n    I -->|是| K[观远读取最新成功数据]\n    K --> L[超级管理员在仪表盘内嵌查看]"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "flowchart TD\n    A[用户消息与AI回答完成] --> B{是否构成有效对话轮次}\n    B -->|否| C[记录失败原因但不计入有效轮次]\n    B -->|是| D[保存用户/部门/模式/智能体等统计维度]\n    D --> R[请求完成后生成实时初算]\n    R --> E[进入每小时增量批次]\n    T[次日重算前一日 Token] --> E\n    E --> F{数据集更新是否成功}\n    F -->|否| G[保留上次成功数据并自动重试]\n    F -->|是| H[记录最近成功时间]\n    G --> H\n    H --> I{观远看板是否已上线}\n    I -->|否| J[仪表盘展示建设中占位]\n    I -->|是| K[观远读取最新成功数据]\n    K --> L[超级管理员在仪表盘内嵌查看]"]]], ["p", {"uuid": "u001516", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "有效对话产生并保存统计维度。"]]], ["p", {"uuid": "u001517", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "每小时增量汇总新增或变化的数据，更新两套数据集；实时初算数据在下一次成功批次后进入观远。"]]], ["p", {"uuid": "u001518", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "次日 Token 重算完成后，将前一自然日发生变化的 Token 与人民币金额纳入下一次小时增量；观远中的前一日数据随该批次校准。"]]], ["p", {"uuid": "u001519", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "记录最近一次成功时间和数据状态，观远读取最新成功版本，并在看板展示“数据更新时间”。"]]], ["p", {"uuid": "u001520", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "观远看板上线前，仪表盘固定区域展示建设中占位；上线后在同一区域内嵌看板。"]]], ["p", {"uuid": "u001521", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001515", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "只有超级管理员可看到入口和内嵌内容。"]]], ["p", {"uuid": "u001522", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "嵌入使用短时单点登录凭证，不在地址中暴露长期 Token。"]]], ["h4", {"uuid": "u001523", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "分支流程（异常流程）"]]], ["p", {"uuid": "u001525", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001524", "isOrdered": false, "level": 0, "listStyle": {"format": "bullet", "text": "●"}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "bold": true}, "数据更新失败："]], ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "本小时汇总任务失败时，保留上次成功数据并记录最近成功时间；系统自动重试，仍失败时支持按原时间区间人工补跑。"]]], ["p", {"uuid": "u001526", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001524", "isOrdered": false, "level": 0, "listStyle": {"format": "bullet", "text": "●"}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "bold": true}, "Token 重算未完成："]], ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "次日重算完成前，观远继续展示实时初算结果并标记“待校准”；重算结果写入后随下一次成功小时批次更新。"]]], ["p", {"uuid": "u001527", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001524", "isOrdered": false, "level": 0, "listStyle": {"format": "bullet", "text": "●"}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "bold": true}, "数据关联失败："]], ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "会话、消息或用户记录无法按稳定 ID 关联时，不将异常记录计入正式指标，写入失败原因；修复源数据后随补跑重新计算。"]]], ["p", {"uuid": "u001528", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u001524", "isOrdered": false, "level": 0, "listStyle": {"format": "bullet", "text": "●"}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "bold": true}, "账号分母为 0："]], ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "当统计范围内没有可计入的启用账号时，渗透率输出为空，并标记“暂无可计算账号”，不输出 0%。"]]], ["h4", {"uuid": "u001529", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "界面原型"]]], ["table", {"bdr": {"bottom": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}, "insideH": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}, "insideV": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}, "left": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}, "right": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}, "top": {"color": "#000000", "space": 0, "sz": 0.67, "val": "single"}}, "colsWidth": [25.0, 25.0, 25.0, 25.0], "jc": "center", "tb