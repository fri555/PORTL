t"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "用户角色与用户故事"]]], ["p", {"uuid": "u002647", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "作为具有知识上传权限的用户，我希望上传文件后由系统自动选择正确解析方式，并在知识库中保留可检索、可追溯的正文和结构信息。"]]], ["h4", {"uuid": "u002648", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "业务主流程图及说明"]]], ["code", {"syntax": "mermaid", "theme": "default", "uuid": "u002649", "code": "flowchart TD\n    A[用户上传本地文件] --> A1[原文件写入 OSS]\n    A1 --> B[校验真实文件格式并创建处理任务]\n    B --> C{格式类型}\n    C -->|Excel| D{是否勾选按月报解析}\n    D -->|是| E[工作簿转换为工作表 JSON 与 CSV]\n    E --> E1[识别标题层级/表头/指标/时间并生成标准月报 JSON]\n    D -->|否| F[沿用普通表格处理]\n    C -->|PPT或PPTX| G[转换为 PDF/逐页 PNG/页面结构 JSON]\n    G --> G1[提取文字/表格/图片说明并按页生成 Markdown]\n    C -->|其他格式| H[沿用现有处理链路]\n    E1 --> P[生成结构化表格预览]\n    G1 --> Q[生成 PDF 预览]\n    P --> I[知识切片与向量化]\n    Q --> I\n    F --> I\n    H --> I\n    I --> J{处理是否成功}\n    J -->|否| K[显示失败原因并支持重试]\n    J -->|是| L[进入现有检索与RAG]"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "flowchart TD\n    A[用户上传本地文件] --> A1[原文件写入 OSS]\n    A1 --> B[校验真实文件格式并创建处理任务]\n    B --> C{格式类型}\n    C -->|Excel| D{是否勾选按月报解析}\n    D -->|是| E[工作簿转换为工作表 JSON 与 CSV]\n    E --> E1[识别标题层级/表头/指标/时间并生成标准月报 JSON]\n    D -->|否| F[沿用普通表格处理]\n    C -->|PPT或PPTX| G[转换为 PDF/逐页 PNG/页面结构 JSON]\n    G --> G1[提取文字/表格/图片说明并按页生成 Markdown]\n    C -->|其他格式| H[沿用现有处理链路]\n    E1 --> P[生成结构化表格预览]\n    G1 --> Q[生成 PDF 预览]\n    P --> I[知识切片与向量化]\n    Q --> I\n    F --> I\n    H --> I\n    I --> J{处理是否成功}\n    J -->|否| K[显示失败原因并支持重试]\n    J -->|是| L[进入现有检索与RAG]"]]], ["p", {"uuid": "u002651", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u002650", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "用户按现有权限上传本地文件，原始二进制文件先写入 OSS；文件记录只保存 OSS 对象标识、校验值和业务元数据，不暴露永久公网地址。"]]], ["p", {"uuid": "u002652", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u002650", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "上传 Excel 时，界面提供“按月报解析”勾选框；默认不勾选。勾选后把各工作表转换为工作表结构 JSON，并为规则表格生成 CSV，再识别月报标题层级、表头、指标、时间和值，形成标准月报 JSON 与 Markdown 知识正文。"]]], ["p", {"uuid": "u002653", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u002650", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "月报预览读取工作表结构 JSON，在前端以表格网格展示工作表、合并表头和单元格显示值；本期不提供 Excel 原文件的 Office 保真预览。"]]], ["p", {"uuid": "u002654", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u002650", "isOrdered": 