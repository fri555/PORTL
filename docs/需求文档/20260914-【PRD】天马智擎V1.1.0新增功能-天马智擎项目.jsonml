", "level": 2, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 2}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 14.5, "szUnit": "pt"}, "M3-用量计费明细"]]], ["h4", {"uuid": "u001083", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "功能需求描述"]]], ["p", {"uuid": "u001084", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "普通用户可从头像下方二级菜单进入“我的用量”，查看本人人民币消耗、可用额度和会话维度消费明细。超级管理员可在“设置 > 用量与计费”查看全组织人民币消耗、金币、Token、调用和结算异常，并通过筛选配置切换公司、部门、用户、会话和单次调用口径，同时设置指定月份的公司总额度。"]]], ["h4", {"uuid": "u001085", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-