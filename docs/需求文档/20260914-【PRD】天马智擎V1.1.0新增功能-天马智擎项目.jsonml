, "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "天马以用户 ID 识别人，通过人员映射表补齐本名和当前花名。页面统一显示“本名（花名）”，人员搜索、接口和工具调用同时接受本名或当前花名。"]]], ["p", {"uuid": "u000430", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "平台不维护历史花名；花名变更后，旧花名不再作为搜索条件。本名重名沿用公司人员主数据中的数字后缀，如“张三”“张三2”。"]]], ["h4", {"uuid": "u000431", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "用户角色与用户故事"]]], ["p", {"uuid": "u000432", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "作为普通用户或超级管理员，我希望无论输入同事的本名还是当前花名，都能准确找到同一账号，并在所有功能中看到一致名称。"]]], ["h4", {"uuid": "u000433", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "ea