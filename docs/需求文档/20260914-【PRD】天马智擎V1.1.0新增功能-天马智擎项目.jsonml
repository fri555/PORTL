af", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt"}, "作为超级管理员，我希望知道谁在什么时间、从哪里、对哪个对象做了什么，以便排查配置变化并追责。普通用户和其他后台角色无权查看。"]]], ["h4", {"uuid": "u000619", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "spacing": {"before": "10pt", "line": 1.5, "lineRule": "auto"}, "list": {"listId": "prd-heading-list", "level": 3, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2.%3.%4", "align": "left"}, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 3}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "color": "#000000", "bold": true, "sz": 13, "szUnit": "pt"}, "业务主流程图及说明"]]], ["code", {"syntax": "mermaid", "theme": "default", "uuid": "u000620", "code": "flowchart TD\n    A[用户或系统执行新增/改名/删除/权限调整] --> B{权限与参数校验}\n    B -->|失败| C[业务不生效并进入安全或错误日志]\n    B -->|通过| D[业务变更生效]\n    D --> E[写入操作人/对象快照/来源/变更内容]\n    E --> F{审计记录是否写入成功}\n    F -->|否| G[不向用户返回业务成功]\n    F -->|是| H[返回操作成功]\n    H --> I[超级管理员按时间/花名等条件查询]\n    I --> J{后续操作}\n    J -->|查看记录| K[查看字段差异或按trace_id串联]\n    J -->|导出| L[下载当前筛选范围的日志]"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "flowchart TD\n    A[用户或系统执行新增/改名/删除/权限调整] --> B{权限与参数校验}\n    B -->|失败| C[业务不生效并进入安全或错误日志]\n    B -->|通过| D[业务变更生效]\n    D --> E[写入操作人/对象快照/来源/变更内容]\n    E --> F{审计记录是否写入成功}\n    F -->|否| G[不向用户返回业务成功]\n    F -->|是| H[返回操作成功]\n    H --> I[超级管理员按时间/花名等条件查询]\n    I --> J{后续操作}\n    J -->|查看记录| K[查看字段差异或按trace_id串联]\n    J -->|导出| L[下载当前筛选范围的日志]"]]], ["p", {"uuid": "u000622", "spacing": {"line": 1.0, "lineRule": "auto"}, "list": {"listId": "list-u000621", "isOrdered": true, "level": 0, "listStyle": {"format": "decimal", "text": "%1."}}}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf", "fonts": {"ascii": "微软雅黑", "