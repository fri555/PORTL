a"}, "data-type": "leaf", "color": "#000000"}, "产品概述"]]], ["p", {"uuid": "u000114", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "data-type": "leaf"}, "本章节详细描述产品的背景、内容和目标等进行详细定义，关于产品定义的其它内容请阅读本产品定义说明书。"]]], ["h2", {"uuid": "u000115", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "styleId": "2", "spacing": {"before": "13pt", "line": 1.73, "lineRule": "auto"}, "list": {"listId": "hlist01", "level": 1, "symbolStyle": {}, "extraData": {}, "listStyleType": "DEC_DEC_DEC_P", "listStyle": {"format": "decimal", "text": "%1.%2", "align": "left"}, "hideSymbol": false, "isTaskList": false, "isOrdered": true, "autoLevel": true}, "numPr": {"id": "3", "level": 1}}, ["span", {"data-type": "text"}, ["span", {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "data-type": "leaf", "color": "#000000"}, "产品概述"]]], ["p", {"uuid": "u000116", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "data-type": "leaf"}, "会议纪要生成待办面向管理层用户，将用户输入的文本内容，通过 AI 提取为结构化待办候选。用户可以逐条审核、编辑 AI 提取结果，选择确认的候选后一次性批量创建钉钉待办。"]]], ["p", {"uuid": "u000117", "spacing": {"line": 1.0, "lineRule": "auto"}}, ["span", {"data-type": "text"}, ["span", {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}, "sz": 12, "szUnit": "pt", "data-type": "leaf"}, "本功能只生成候选和创建待办，不替代钉钉待办系统。AI 提取结果必须经用户确认后才能写入待办系统。"]]], ["h2", {"uuid": "u000118", "rPr": {"fonts": {"ascii": "微软雅黑", "cs": "Arial", "eastAsia": "微软雅黑", "hAnsi": "微软雅黑", "hint": "eastAsia"}}, "styleId": "2", "spacing": {"before": "13pt", "line": 1.73, "lineRule": "auto"}, "list": {"listId": "hlis